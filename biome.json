{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": { "includes": ["src/**", "vite.config.ts"] },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 110 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useKeyWithClickEvents": "off",
        "noSvgWithoutTitle": "off",
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off"
      },
      "security": { "noDangerouslySetInnerHtml": "off" },
      "suspicious": { "noArrayIndexKey": "off", "noTemplateCurlyInString": "off" },
      "complexity": { "noImportantStyles": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
