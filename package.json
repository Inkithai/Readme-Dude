{
  "name": "readme-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A visual GitHub README design studio \u2014 compose, customize, preview and export READMEs without writing Markdown by hand.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test:ui": "vitest run --environment jsdom src/ui"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "github-markdown-css": "5.9.0",
    "highlight.js": "11.12.0",
    "immer": "^11.1.18",
    "lowlight": "3.3.0",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "zod": "4.4.3",
    "zundo": "2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.0.1",
    "simple-icons": "16.28.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
